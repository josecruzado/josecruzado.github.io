---
/**
 * BaseLayout — esqueleto HTML mínimo.
 * Compone <head> con SEO + JSON-LD y aplica el theme antes del primer paint.
 */
import '../styles/global.css';
import SEO from '../components/seo/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { Font } from 'astro:assets';
import { SITE } from '../lib/site';

const htmlLang = SITE.locale.split('-')[0];

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
}

const {
  title,
  description = SITE.seo.defaultDescription,
  image,
  canonical,
  type = 'profile',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={htmlLang} data-theme="dark">
  <head>
    <SEO
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      type={type}
      noindex={noindex}
    />
    <JsonLd />
    {
      /* <Font /> emite el @font-face y, con preload, el <link rel=preload>
         apuntando al mismo archivo hasheado. Va antes del CSS para que la
         descarga arranque en el punto más temprano del parsing del head.
         Las dos fuentes se precargan porque ambas son visibles en el primer
         viewport: Inter en el cuerpo e Cascadia en los display headings. */
    }
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-cascadia" preload />
    <link rel="manifest" href="/manifest.webmanifest" />
    {
      /* Theme bootstrap — aplicado antes del primer paint para evitar
         flash de tema incorrecto. Lee localStorage o prefers-color-scheme,
         setea data-theme, y sincroniza meta theme-color dinámico para
         que la status bar del browser refleje la elección desde el inicio. */
    }
    <script is:inline>
      (() => {
        const html = document.documentElement;
        try {
          const saved = localStorage.getItem('theme');
          const prefers = window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
          // Se valida el valor persistido en lugar de confiar en él: un
          // localStorage corrupto (otra extensión, una clave 'theme'
          // reutilizada, un valor de una versión anterior) dejaba
          // data-theme sin coincidir con ningún selector de tokens.css,
          // el documento se quedaba sin color-scheme y light-dark()
          // resolvía a claro sobre un HTML que declaraba otro tema.
          const theme = saved === 'light' || saved === 'dark' ? saved : prefers;
          html.dataset.theme = theme;
          const meta = document.querySelector('meta[data-dynamic-theme]');
          // Los hex viven en site.ts y llegan como data-* en la propia
          // meta: aquí no se repite ningún color.
          const color =
            meta && meta.dataset[theme === 'light' ? 'themeColorLight' : 'themeColorDark'];
          if (color) meta.setAttribute('content', color);
        } catch (_) {
          /* SSR/no-storage: usa el default del HTML */
        }
      })();
    </script>
  </head>
  <body>
    <div class="ambient-bg" aria-hidden="true"></div>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <slot />

    <script>
      // Smooth scroll global para anchor clicks (#xxx) vía scrollIntoView
      // nativo + scroll-padding-top del browser. Sin librería.
      import '../scripts/smooth-scroll.ts';

      // Magnetic hover en CTAs primarios (CV + Enviar email + dock CV).
      // Solo ~30 LOC, sin Motion. Hero entrance vía CSS keyframes
      // (utilities.css). Card lift vía CSS :hover (Card.astro).
      import '../scripts/magnetic.ts';

      // Page Visibility API: pausa la animación infinita restante (float
      // del avatar) cuando la pestaña queda oculta. Battery saver real
      // en mobile + libera ciclos para la tab activa. El listener de
      // scroll-state previo fue removido: con solo 1 animación GPU-cheap
      // restante, el overhead del listener superaba el beneficio.
      document.addEventListener('visibilitychange', () => {
        document.documentElement.classList.toggle('is-page-hidden', document.hidden);
      });

      // Reveal de .project vía native scroll-driven animations
      // (animation-timeline: view() en utilities.css). Sin IntersectionObserver.
    </script>
  </body>
</html>
