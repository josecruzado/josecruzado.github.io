---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Portfolio de Backend Developer" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="16x16" href="/memoji.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/memoji.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/memoji.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/memoji.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      // Forzar recalculo de estilos en resize para mejor responsividad
      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          // Forzar reflow para que los media queries se apliquen correctamente
          document.body.style.display = 'none';
          document.body.offsetHeight; // trigger reflow
          document.body.style.display = '';
        }, 250);
      });
      
      // Asegurar que los estilos se apliquen correctamente al cargar
      window.addEventListener('load', () => {
        setTimeout(() => {
          document.body.style.visibility = 'visible';
        }, 100);
      });
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  
  html {
    scroll-behavior: smooth;
  }
  
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #000000;
    color: #ffffff;
    line-height: 1.6;
    overflow-x: hidden;
    transition: background-color 0.3s ease, color 0.3s ease;
    visibility: hidden; /* Inicialmente oculto hasta que se cargue */
  }

  /* Dark theme (default) */
  body.dark-theme {
    background: #000000;
    color: #ffffff;
  }

  /* Light theme */
  body.light-theme {
    background: #ffffff;
    color: #1f2937;
  }

  /* Update specific elements for light theme */
  body.light-theme .hero-bg .hero-circle {
    opacity: 0.3;
  }

  body.light-theme .about {
    background: linear-gradient(180deg, #f9fafb 0%, #e5e7eb 50%, #f9fafb 100%);
  }

  body.light-theme .projects {
    background: linear-gradient(180deg, #f9fafb 0%, #e5e7eb 50%, #f9fafb 100%);
  }

  body.light-theme .hero-subtitle,
  body.light-theme .about-description,
  body.light-theme .project-description,
  body.light-theme .achievement-item {
    color: #6b7280;
  }

  body.light-theme .stat-label,
  body.light-theme .section-subtitle,
  body.light-theme .experience-period,
  body.light-theme .card-subtitle,
  body.light-theme .tech-tag,
  body.light-theme .contact-subtitle,
  body.light-theme .footer {
    color: #9ca3af;
  }

  body.light-theme .experience-content,
  body.light-theme .project-card,
  body.light-theme .about-card {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.1);
  }

  body.light-theme .experience-content:hover,
  body.light-theme .project-card:hover {
    background: rgba(0, 0, 0, 0.1);
    border-color: rgba(6, 182, 212, 0.3);
  }

  body.light-theme .tech-badge {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.1);
    color: #4b5563;
  }

  body.light-theme .floating-nav-container {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(0, 0, 0, 0.1);
    box-shadow: 
      0 10px 32px rgba(0, 0, 0, 0.1),
      0 4px 16px rgba(0, 0, 0, 0.05),
      inset 0 1px 0 rgba(0, 0, 0, 0.1);
  }

  body.light-theme .nav-item {
    color: rgba(0, 0, 0, 0.7);
  }

  body.light-theme .nav-item:hover {
    color: #000;
    background: rgba(0, 0, 0, 0.05);
  }

  body.light-theme .theme-toggle {
    background: rgba(0, 0, 0, 0.05);
    color: rgba(0, 0, 0, 0.7);
  }

  body.light-theme .theme-toggle:hover {
    background: rgba(0, 0, 0, 0.1);
    color: #000;
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
    font-size: 1rem;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, #06b6d4, #3b82f6);
    color: white;
  }
  
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(6, 182, 212, 0.3);
  }
  
  .btn-secondary {
    background: transparent;
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.2);
  }
  
  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  
  .gradient-text {
    background: linear-gradient(135deg, #06b6d4, #3b82f6, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.05); }
  }
  
  .animate-pulse {
    animation: pulse 4s ease-in-out infinite;
  }
  
  .backdrop-blur {
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
</style>