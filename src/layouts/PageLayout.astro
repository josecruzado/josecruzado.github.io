---
import BaseLayout from './BaseLayout.astro';
import FloatingNav from '../components/nav/FloatingNav.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <FloatingNav />
  <!--
    tabindex="-1" permite que el skip-link mueva el foco aquí
    realmente. Sin esto el browser hace scroll a #main pero deja el
    foco en <body>; el siguiente Tab cae en el nav, frustrando el
    propósito del skip (WCAG 2.4.1). -1 lo hace programáticamente
    enfocable sin entrar en el orden tabular natural.
  -->
  <main id="main" tabindex="-1">
    <slot />
  </main>
</BaseLayout>
