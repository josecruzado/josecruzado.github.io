<style>
/* About Section */
.about {
  min-height: 100vh;
  min-height: 100dvh; /* Dynamic viewport height para mejor soporte mobile */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 0;
  background: linear-gradient(180deg, #000000 0%, #0f0f0f 50%, #111827 100%);
  position: relative;
  overflow: hidden;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  position: relative;
  z-index: 10;
  width: 100%;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
  align-items: center;
}

.section-title {
  font-size: 2.5rem;
  font-weight: bold;
  margin-bottom: 1.5rem;
  line-height: 1.2;
}

.gradient-text {
  background: linear-gradient(135deg, #06b6d4, #3b82f6, #8b5cf6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.about-description {
  font-size: 1.125rem;
  color: #9ca3af;
  line-height: 1.7;
  margin-bottom: 1.5rem;
}

.social-links {
  display: flex;
  gap: 1rem;
}

.social-link {
  color: #06b6d4;
  transition: color 0.3s;
}

.social-link:hover {
  color: #0891b2;
}

.social-link svg {
  width: 1.5rem;
  height: 1.5rem;
}

.about-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}

.about-card {
  padding: 1.5rem;
  border-radius: 1rem;
  border: 1px solid;
  transition: all 0.3s;
}

.about-card:hover {
  transform: translateY(-2px);
}

.about-card-1 {
  background: linear-gradient(135deg, rgba(6, 182, 212, 0.1), rgba(59, 130, 246, 0.1));
  border-color: rgba(6, 182, 212, 0.2);
}

.about-card-2 {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(236, 72, 153, 0.1));
  border-color: rgba(139, 92, 246, 0.2);
}

.about-card-3 {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(20, 184, 166, 0.1));
  border-color: rgba(16, 185, 129, 0.2);
}

.about-card-4 {
  background: linear-gradient(135deg, rgba(249, 115, 22, 0.1), rgba(239, 68, 68, 0.1));
  border-color: rgba(249, 115, 22, 0.2);
}

.card-emoji {
  font-size: 2rem;
  margin-bottom: 1rem;
}

.card-title {
  font-size: 1.25rem;
  font-weight: bold;
  margin-bottom: 0.5rem;
}

.card-subtitle {
  font-size: 0.875rem;
  color: #9ca3af;
}

/* Responsive Design */
@media (min-width: 768px) {
  .about-grid {
    grid-template-columns: 2fr 1fr;
  }
}
</style>