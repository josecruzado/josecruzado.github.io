---
/**
 * JsonLd — Structured data Schema.org (@graph con Person + WebSite + ProfilePage).
 * Validable en https://search.google.com/test/rich-results
 *
 * `knowsAbout` se deriva de SKILLS para mantener una única fuente de verdad
 * con la sección Habilidades.
 */
import { getCollection } from 'astro:content';
import { SITE } from '../../lib/site';
import { SKILLS } from '../../lib/skills';

const personId = `${SITE.url}/#person`;
const websiteId = `${SITE.url}/#website`;
const profileId = `${SITE.url}/#profile`;

const knowsAbout = SKILLS.flatMap((category) => category.skills.map((s) => s.name));

const experiences = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const currentExperience = experiences.find((e) => e.data.isCurrent) ?? experiences[0];

// `endDate: 'present'` (texto humano) se normaliza a undefined para que
// Schema.org no reciba un valor no-fecha. Los crawlers infieren "vigente"
// por la ausencia de endDate (patrón estándar Schema.org).
const toIsoEnd = (raw: string): string | undefined => (raw && raw !== 'present' ? raw : undefined);

// worksFor: Organization actual enriquecida con url y sameAs (Wikidata)
// cuando están disponibles → señal fuerte para el Knowledge Graph.
const worksFor: Record<string, unknown> = {
  '@type': 'Organization',
  name: currentExperience?.data.company ?? 'Independent',
};
if (currentExperience?.data.companyUrl) worksFor.url = currentExperience.data.companyUrl;
if (currentExperience?.data.companyWikidata)
  worksFor.sameAs = currentExperience.data.companyWikidata;

// hasOccupation como ARRAY — una Occupation por cada experience.
// Enriquece el rich snippet con la trayectoria completa: responsibilities
// derivadas de achievements, skills derivadas de technologies, fechas
// ISO, ubicación. La occupational category 15-1252.00 (SOC: Software
// Developers, Applications) se aplica solo a la actual.
const occupations = experiences.map((exp) => {
  const item: Record<string, unknown> = {
    '@type': 'Occupation',
    name: exp.data.role,
    description: exp.data.summary,
    startDate: exp.data.startDate,
    occupationLocation: {
      '@type': 'City',
      name: exp.data.location,
    },
    skills: exp.data.technologies.join(', '),
    responsibilities: exp.data.achievements.join(' | '),
  };
  const endDate = toIsoEnd(exp.data.endDate);
  if (endDate) item.endDate = endDate;
  if (exp.data.isCurrent) item.occupationalCategory = '15-1252.00';
  return item;
});

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: SITE.author.name,
      givenName: SITE.author.firstName,
      familyName: SITE.author.lastName,
      alternateName: SITE.author.displayName,
      jobTitle: SITE.author.role,
      description: SITE.author.bio,
      url: SITE.url,
      image: new URL(SITE.seo.ogImage, SITE.url).href,
      email: SITE.author.email,
      telephone: SITE.author.phoneE164,
      address: {
        '@type': 'PostalAddress',
        addressLocality: SITE.author.location.city,
        addressCountry: SITE.author.location.countryCode,
      },
      worksFor,
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: SITE.author.university,
      },
      hasOccupation: occupations,
      knowsAbout,
      knowsLanguage: SITE.author.languages.map((lang) => ({
        '@type': 'Language',
        name: lang.name,
        alternateName: lang.code,
      })),
      sameAs: [SITE.social.linkedin, SITE.social.github],
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: SITE.url,
      name: `${SITE.author.displayName} · Portfolio`,
      description: SITE.seo.defaultDescription,
      inLanguage: SITE.locale,
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': profileId,
      url: SITE.url,
      name: SITE.seo.defaultTitle,
      description: SITE.seo.defaultDescription,
      inLanguage: SITE.locale,
      mainEntity: { '@id': personId },
      isPartOf: { '@id': websiteId },
    },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
