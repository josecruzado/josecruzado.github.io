---
/**
 * Section — wrapper semántico minimal.
 * Sin eyebrow/subtitle por defecto; las secciones que quieran header
 * lo construyen como contenido para evitar el patrón repetido.
 */

/**
 * Forma del contenido que envuelve la sección. Solo se usa para estimar
 * su altura mientras está fuera de pantalla (`contain-intrinsic-size`).
 *
 * Se nombra por la FORMA del layout y no por la sección concreta a
 * propósito: un primitivo de propósito general no debería conocer los
 * ids de la aplicación. Antes las alturas se seleccionaban desde aquí
 * con selectores por `data-nav-section`, de modo que renombrar una
 * sección descalibraba el anchor scroll en silencio.
 */
type ContentShape = 'bio' | 'tabs' | 'cards' | 'list' | 'timeline' | 'split';

interface Props {
  id: string;
  ariaLabel?: string;
  fullHeight?: boolean;
  /** Ver ContentShape. Sin valor se aplica la estimación genérica. */
  shape?: ContentShape;
  /**
   * Habilita `content-visibility: auto` — el browser omite el render
   * de la sección mientras está offscreen. Default: true para
   * secciones no full-height (Hero/Contact mantienen render eager
   * para preservar el layout fluido del entrance y del CTA final).
   */
  lazyRender?: boolean;
  class?: string;
}

const {
  id,
  ariaLabel,
  fullHeight = false,
  lazyRender = !fullHeight,
  shape,
  class: className,
} = Astro.props;

const sectionClass = [
  'section',
  fullHeight && 'section--full',
  lazyRender && 'section--lazy',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<section
  class={sectionClass}
  aria-label={ariaLabel}
  data-nav-section={id}
  data-shape={lazyRender ? shape : undefined}
>
  <div id={id} class="container">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-padding);
    position: relative;
    /* contain: layout style le dice al browser que los cambios DENTRO
       del section no afectan layout/style FUERA. Durante scroll, esto
       evita que el browser recalcule layout de toda la página por
       cambios en una sola sección. paint NO se incluye para no romper
       el .hero__scroll-hint (absolute) ni elementos fuera del flow. */
    contain: layout style;
  }

  .section--full {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
  }

  /* content-visibility: auto pinta la sección solo cuando se acerca al
     viewport. El browser memoriza el alto real tras el primer render
     (contain-intrinsic-size: auto), pero el VALOR inicial es el que
     determina la posición de un anchor scroll hacia secciones todavía
     sin renderear. De ahí que cada forma de contenido declare su propia
     estimación: evita el undershoot en clicks tempranos del menú. */
  .section--lazy {
    content-visibility: auto;
    contain-intrinsic-size: auto 800px;
  }

  .section--lazy[data-shape='bio'] {
    contain-intrinsic-size: auto 600px;
  }
  .section--lazy[data-shape='tabs'] {
    contain-intrinsic-size: auto 1200px;
  }
  .section--lazy[data-shape='cards'] {
    contain-intrinsic-size: auto 1400px;
  }
  .section--lazy[data-shape='list'],
  .section--lazy[data-shape='timeline'] {
    contain-intrinsic-size: auto 700px;
  }
  /* `split`: dos paneles con scroll interno acotado, así que su altura
     apenas varía con el contenido. Medida: 1139px desktop, 1311px mobile. */
  .section--lazy[data-shape='split'] {
    contain-intrinsic-size: auto 1140px;
  }

  /* En mobile las secciones colapsan a una columna y crecen en vertical.
     Las estimaciones suben para que la suma de placeholders se acerque a
     la altura real antes del primer render. `bio` no cambia: su altura
     apenas varía al colapsar. */
  @media (max-width: 640px) {
    .section--lazy[data-shape='tabs'] {
      contain-intrinsic-size: auto 1600px;
    }
    .section--lazy[data-shape='cards'] {
      contain-intrinsic-size: auto 2200px;
    }
    .section--lazy[data-shape='list'] {
      contain-intrinsic-size: auto 900px;
    }
    .section--lazy[data-shape='timeline'] {
      contain-intrinsic-size: auto 1100px;
    }
  }
</style>
