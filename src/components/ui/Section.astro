---
/**
 * Section — wrapper semántico minimal.
 * Sin eyebrow/subtitle por defecto; las secciones que quieran header
 * lo construyen como contenido para evitar el patrón repetido.
 */
interface Props {
  id: string;
  ariaLabel?: string;
  fullHeight?: boolean;
  /**
   * Habilita `content-visibility: auto` — el browser omite el render
   * de la sección mientras está offscreen. Default: true para
   * secciones no full-height (Hero/Contact mantienen render eager
   * para preservar el layout fluido del entrance y del CTA final).
   */
  lazyRender?: boolean;
  class?: string;
}

const {
  id,
  ariaLabel,
  fullHeight = false,
  lazyRender = !fullHeight,
  class: className,
} = Astro.props;

const sectionClass = [
  'section',
  fullHeight && 'section--full',
  lazyRender && 'section--lazy',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<section class={sectionClass} aria-label={ariaLabel} data-nav-section={id}>
  <div id={id} class="container">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-padding);
    position: relative;
    /* contain: layout style le dice al browser que los cambios DENTRO
       del section no afectan layout/style FUERA. Durante scroll, esto
       evita que el browser recalcule layout de toda la página por
       cambios en una sola sección. paint NO se incluye para no romper
       el .hero__scroll-hint (absolute) ni elementos fuera del flow. */
    contain: layout style;
  }

  .section--full {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
  }

  /* content-visibility: auto pinta la sección solo cuando se acerca
     al viewport. El browser memoriza el alto real tras el primer
     render (contain-intrinsic-size: auto), pero el VALOR inicial es
     el que determina la posición de un anchor scroll hacia secciones
     aún no rendereadas. Ajustes calibrados por sección via el
     atributo data-nav-section que ya emitimos: evita undershoot en
     clicks tempranos a #educacion / #contacto. */
  .section--lazy {
    content-visibility: auto;
    contain-intrinsic-size: auto 800px;
  }

  .section--lazy[data-nav-section='sobre-mi'] {
    contain-intrinsic-size: auto 600px;
  }
  .section--lazy[data-nav-section='experiencia'] {
    contain-intrinsic-size: auto 1200px;
  }
  .section--lazy[data-nav-section='proyectos'] {
    contain-intrinsic-size: auto 1400px;
  }
  .section--lazy[data-nav-section='habilidades'] {
    contain-intrinsic-size: auto 700px;
  }
  .section--lazy[data-nav-section='educacion'] {
    contain-intrinsic-size: auto 700px;
  }

  /* En mobile las secciones colapsan a una columna y crecen verticalmente.
     Ajustamos hacia arriba para que la suma de placeholders ≈ altura real
     antes del primer render. */
  @media (max-width: 640px) {
    .section--lazy[data-nav-section='experiencia'] {
      contain-intrinsic-size: auto 1600px;
    }
    .section--lazy[data-nav-section='proyectos'] {
      contain-intrinsic-size: auto 2200px;
    }
    .section--lazy[data-nav-section='habilidades'] {
      contain-intrinsic-size: auto 900px;
    }
    .section--lazy[data-nav-section='educacion'] {
      contain-intrinsic-size: auto 1100px;
    }
  }
</style>
