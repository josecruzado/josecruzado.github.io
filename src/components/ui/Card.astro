---
/**
 * Card — superficie elevada minimalista con efecto premium.
 */
type Tag = 'div' | 'article' | 'li' | 'a';

interface Props {
  as?: Tag;
  href?: string;
  interactive?: boolean;
  class?: string;
  accent?: 'cyan' | 'blue' | 'purple' | 'pink' | 'orange' | 'green';
}

const {
  as = 'div',
  href,
  interactive = !!href,
  class: className,
  accent = 'cyan',
} = Astro.props as Props;
const Tag = as;
const classes = ['card', interactive && 'card--interactive', className].filter(Boolean).join(' ');
---

<Tag class={classes} data-accent={accent} {...href ? { href } : {}}>
  <div class="card__spotlight" aria-hidden="true"></div>
  <div class="card__content">
    <slot />
  </div>
</Tag>

<script>
  const setupSpotlights = () => {
    const cards = document.querySelectorAll('.card--interactive');
    cards.forEach((card) => {
      if ((card as HTMLElement).dataset.spotlightSetup === 'true') return;
      (card as HTMLElement).dataset.spotlightSetup = 'true';
      card.addEventListener('mousemove', (e: any) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
        (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
      });
    });
  };

  setupSpotlights();
  document.addEventListener('astro:page-load', setupSpotlights);
</script>

<style>
  .card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
    transition:
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .card__content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    height: 100%;
    z-index: 2;
    background: var(--color-surface);
    transition: background-color var(--duration-base) var(--ease-out);
    border-radius: inherit;
  }

  .card__spotlight {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
    background: radial-gradient(
      400px circle at var(--mouse-x, 0) var(--mouse-y, 0),
      var(--color-surface-hover),
      transparent 40%
    );
  }

  .card--interactive:hover .card__spotlight {
    opacity: 1;
  }

  .card--interactive:hover .card__content {
    background: transparent;
  }

  .card--interactive:hover {
    border-color: var(--card-accent-ring, var(--color-border-strong));
    transform: translateY(-2px);
  }

  .card[data-accent='cyan'] {
    --card-accent-ring: rgba(6, 182, 212, 0.3);
  }

  .card[data-accent='blue'] {
    --card-accent-ring: rgba(59, 130, 246, 0.3);
  }

  .card[data-accent='purple'] {
    --card-accent-ring: rgba(139, 92, 246, 0.32);
  }

  .card[data-accent='pink'] {
    --card-accent-ring: rgba(236, 72, 153, 0.3);
  }

  .card[data-accent='orange'] {
    --card-accent-ring: rgba(249, 115, 22, 0.3);
  }

  .card[data-accent='green'] {
    --card-accent-ring: rgba(16, 185, 129, 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .card--interactive:hover {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .card {
      border-radius: var(--radius-md);
    }

    .card__content {
      padding: var(--space-5);
    }
  }
</style>
