---
/**
 * Card — superficie elevada minimalista.
 *
 * Spotlight removido: estaba gated por `interactive` (cards con href),
 * pero ningún consumer actual del portfolio usa href en sus Cards
 * (Projects + Education son informativas). El código corría siempre
 * pero nunca se mostraba — dead code.
 *
 * El prop `interactive` se mantiene en la API por si futuras Cards
 * se convierten en clickeables (link de proyecto, ej.), aunque hoy
 * solo añade la clase para hover state.
 */
type Tag = 'div' | 'article' | 'li' | 'a';

interface Props {
  as?: Tag;
  href?: string;
  interactive?: boolean;
  class?: string;
  accent?: 'cyan' | 'blue' | 'purple' | 'pink' | 'orange' | 'green';
}

const {
  as = 'div',
  href,
  interactive = !!href,
  class: className,
  accent = 'cyan',
} = Astro.props as Props;
const Tag = as;
const classes = ['card', interactive && 'card--interactive', className].filter(Boolean).join(' ');
---

<Tag class={classes} data-accent={accent} {...href ? { href } : {}}>
  <div class="card__content">
    <slot />
  </div>
</Tag>

<style>
  .card {
    /* container-type permite que los hijos consulten el ancho
       del card vía @container — independiente del viewport. */
    container-type: inline-size;
    container-name: card;

    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
    transition:
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .card__content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border-radius: inherit;
  }

  /* Card auto-responsive: cuando el card mismo es estrecho
     (independiente del viewport), reduce padding y radius.
     Threshold 22rem (~352px) cubre solo cards en mobile single-col;
     evita aplicarse a primary projects desktop (~400px). */
  @container card (max-width: 22rem) {
    .card {
      border-radius: var(--radius-md);
    }
    .card__content {
      padding: var(--space-5);
    }
  }

  /* Lift + border accent en hover aplica a TODAS las cards (informativas
     o clickeables). (hover: hover) evita que touch devices queden con
     estado sticky tras tap. La GPU promueve transform sin will-change. */
  @media (hover: hover) {
    .card:hover {
      border-color: var(--card-accent-ring, var(--color-border-strong));
      transform: translateY(-2px);
    }
  }

  .card[data-accent='cyan'] {
    --card-accent-ring: rgba(6, 182, 212, 0.3);
  }

  .card[data-accent='blue'] {
    --card-accent-ring: rgba(59, 130, 246, 0.3);
  }

  .card[data-accent='purple'] {
    --card-accent-ring: rgba(139, 92, 246, 0.32);
  }

  .card[data-accent='pink'] {
    --card-accent-ring: rgba(236, 72, 153, 0.3);
  }

  .card[data-accent='orange'] {
    --card-accent-ring: rgba(249, 115, 22, 0.3);
  }

  .card[data-accent='green'] {
    --card-accent-ring: rgba(16, 185, 129, 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }
</style>
