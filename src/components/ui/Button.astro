---
/**
 * Button — átomo polimorfo.
 * Variants:
 *   - primary : acento sólido cyan (un solo CTA por viewport)
 *   - secondary : outline neutro
 *   - link : subrayado tipográfico (uso editorial)
 */
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'link';
type Size = 'sm' | 'md' | 'lg';

type CommonProps = {
  variant?: Variant;
  size?: Size;
  class?: string;
};

/**
 * Discriminated union: cuando `as="button"` se aceptan props de <button>
 * (incl. `type`, `disabled`) y se rechaza `href`. Cuando `as="a"` (default)
 * se aceptan props de <a> (incl. `href`, `target`, `download`) y se rechaza
 * `type="submit"`. Esto evita la unión laxa que permitía mezclar atributos.
 */
type Props =
  | (CommonProps & { as?: 'a' } & HTMLAttributes<'a'>)
  | (CommonProps & { as: 'button' } & HTMLAttributes<'button'>);

const {
  as = 'a',
  variant = 'primary',
  size = 'md',
  class: className,
  ...rest
} = Astro.props as Props;

const Tag = as;
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className].filter(Boolean).join(' ');
---

<Tag class={classes} {...(rest as Record<string, unknown>)}>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-weight: var(--weight-medium);
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    cursor: pointer;
    /* Transición específica (no `all`) — evita repintar propiedades no
       declaradas y reduce el cost del compositor en hover masivo. */
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    white-space: nowrap;
  }

  .btn:active {
    transform: scale(0.96);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
    .btn:active {
      transform: none;
    }
  }

  .btn--sm {
    padding: 0.5rem 1.1rem;
    font-size: var(--text-xs);
  }
  .btn--md {
    padding: 0.7rem 1.5rem;
    font-size: var(--text-sm);
  }
  .btn--lg {
    padding: 0.95rem 1.8rem;
    font-size: var(--text-sm);
  }

  .btn--primary {
    background: var(--color-accent);
    color: var(--color-accent-fg);
    box-shadow: 0 0 12px var(--color-accent-soft);
  }
  .btn--primary:hover {
    background: var(--color-accent-hover);
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.4);
  }

  .btn--secondary {
    background: var(--color-surface);
    color: var(--color-fg);
    border-color: var(--color-border);
  }
  .btn--secondary:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-border-strong);
  }

  .btn--link {
    padding: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-fg-muted);
    font-weight: var(--weight-medium);
    border-bottom: 1px solid transparent;
  }
  .btn--link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
