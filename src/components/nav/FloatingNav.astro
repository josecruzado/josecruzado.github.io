---
import Icon from '../ui/Icon.astro';
import { SITE } from '../../lib/site';

const navItems = SITE.nav;
---

<nav class="nav" aria-label="Navegación principal">
  <div class="nav__inner">
    <ul class="nav__menu" role="list">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class="nav__item" data-nav-item aria-label={item.label}>
              <span class="nav__icon-wrapper">
                <Icon name={item.icon} size={15} class="nav__icon" />
              </span>
              <span class="nav__label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav__actions">
      <a href="/cv.pdf" class="nav__cv" download="Jose-Cruzado-CV.pdf" aria-label="Descargar CV">
        <span>CV</span>
        <Icon name="lucide:arrow-down" size={13} />
      </a>

      <button
        type="button"
        class="nav__theme"
        data-theme-toggle
        aria-label="Cambiar tema"
        aria-pressed="false"
      >
        <Icon name="lucide:sun" size={15} class="theme-icon theme-icon--sun" />
        <Icon name="lucide:moon" size={15} class="theme-icon theme-icon--moon" />
      </button>
    </div>
  </div>
</nav>

<script>
  const THEME_KEY = 'theme';
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  function syncToggle() {
    if (!toggle) return;
    const isLight = root.dataset.theme === 'light';
    toggle.setAttribute('aria-pressed', String(isLight));
    toggle.setAttribute('aria-label', isLight ? 'Activar tema oscuro' : 'Activar tema claro');
  }
  syncToggle();

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    localStorage.setItem(THEME_KEY, next);
    syncToggle();
  });

  const items = document.querySelectorAll<HTMLAnchorElement>('[data-nav-item]');
  const sections = document.querySelectorAll<HTMLElement>('main section[data-nav-section]');
  const nav = document.querySelector<HTMLElement>('.nav');

  function getScrollOffset() {
    const navHeight = nav?.getBoundingClientRect().height ?? 48;
    const breathingRoom = window.matchMedia('(max-width: 768px)').matches ? 16 : 24;
    return navHeight + breathingRoom;
  }

  items.forEach((item) => {
    item.addEventListener('click', (event) => {
      const href = item.getAttribute('href');
      if (!href?.startsWith('#')) return;

      event.preventDefault();
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targetTop =
        href === '#inicio'
          ? 0
          : Math.max(
              0,
              (document.querySelector(href)?.getBoundingClientRect().top ?? 0) +
                window.scrollY -
                getScrollOffset()
            );

      window.scrollTo({
        top: targetTop,
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
      });

      history.pushState(null, '', href);
      nav?.classList.remove('is-hidden');
    });
  });

  function setActiveNav(id: string | null) {
    items.forEach((item) => {
      const isActive = item.getAttribute('href') === `#${id}`;
      item.classList.toggle('is-active', isActive);
      if (isActive) item.setAttribute('aria-current', 'true');
      else item.removeAttribute('aria-current');
    });
  }

  function syncActiveNav() {
    const probe = window.scrollY + getScrollOffset() + window.innerHeight * 0.22;
    let activeId = sections[0]?.getAttribute('data-nav-section') ?? null;

    sections.forEach((section) => {
      if (section.offsetTop <= probe) {
        activeId = section.getAttribute('data-nav-section');
      }
    });

    setActiveNav(activeId);
  }

  let lastY = window.scrollY;
  let ticking = false;

  function handleScroll() {
    const y = window.scrollY;
    const delta = y - lastY;
    if (Math.abs(delta) > 10 && nav) {
      const shouldHide = delta > 0 && y > 180;
      nav.classList.toggle('is-hidden', shouldHide);
      nav.classList.toggle('is-scrolled', y > 40);
    }
    syncActiveNav();
    lastY = y;
    ticking = false;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(handleScroll);
        ticking = true;
      }
    },
    { passive: true }
  );

  syncActiveNav();
</script>

<style>
  .nav {
    position: fixed;
    top: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--z-nav);
    transition:
      transform var(--duration-base) var(--ease-out),
      opacity var(--duration-base) var(--ease-out);
  }

  .nav.is-hidden {
    transform: translateX(-50%) translateY(-120%);
    opacity: 0;
    pointer-events: none;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: color-mix(in srgb, var(--color-bg-elevated) 88%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.4rem 0.5rem 0.4rem 0.65rem;
  }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin-inline: 0.35rem;
  }

  .nav__item {
    display: inline-flex;
    align-items: center;
    gap: 0;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-full);
    color: var(--color-fg-muted);
    font-size: 0.8125rem;
    font-weight: var(--weight-medium);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav__icon-wrapper {
    display: none;
  }

  .nav__item:hover {
    color: var(--color-fg);
  }

  .nav__item.is-active {
    color: var(--color-fg);
  }
  .nav__item.is-active .nav__label::after {
    content: '';
    display: block;
    margin-top: 2px;
    height: 2px;
    background: var(--color-accent);
    border-radius: 1px;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding-left: 0.4rem;
    border-left: 1px solid var(--color-border);
  }

  .nav__cv {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .nav__cv:hover {
    background: var(--color-fg);
    color: var(--color-bg);
  }

  .nav__theme {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    color: var(--color-fg-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }
  .nav__theme:hover {
    color: var(--color-fg);
  }
  .nav__theme :global(.theme-icon) {
    position: absolute;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }
  :global([data-theme='dark']) .nav__theme :global(.theme-icon--moon) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  :global([data-theme='light']) .nav__theme :global(.theme-icon--sun) {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  /* ------------------------------- Responsive */
  @media (max-width: 768px) {
    .nav {
      top: 0.75rem;
      bottom: auto;
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      width: max-content;
      max-width: calc(100dvw - 1rem);
      contain: layout paint;
    }

    .nav.is-hidden {
      transform: translateX(-50%) translateY(-140%);
      opacity: 0;
      pointer-events: none;
    }

    .nav__inner {
      justify-content: center;
      width: max-content;
      max-width: calc(100dvw - 1rem);
      padding: 0.35rem;
      border-radius: var(--radius-full);
      gap: 0.3rem;
      box-shadow: none;
    }

    .nav__menu {
      flex: 0 1 auto;
      justify-content: center;
      gap: 0.2rem;
      margin-inline: 0;
    }

    .nav__item {
      width: 2.45rem;
      height: 2.45rem;
      padding: 0;
      flex-direction: row;
      min-width: auto;
      flex: 0 0 auto;
      justify-content: center;
      border-radius: var(--radius-full);
      gap: 0;
      transition:
        background-color var(--duration-fast) var(--ease-out),
        color var(--duration-fast) var(--ease-out);
      -webkit-tap-highlight-color: transparent;
    }

    .nav__icon-wrapper {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      width: auto;
      height: auto;
    }

    .nav__icon {
      display: block;
      width: 17px;
      height: 17px;
    }

    .nav__label {
      display: none;
    }

    .nav__item.is-active .nav__label::after {
      display: none;
    }

    .nav__item.is-active {
      color: var(--color-accent);
      background: transparent;
      box-shadow: none;
    }

    .nav__item.is-active .nav__icon-wrapper {
      position: relative;
    }

    .nav__item.is-active .nav__icon-wrapper::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: -0.45rem;
      width: 0.25rem;
      height: 0.25rem;
      border-radius: var(--radius-full);
      background: var(--color-accent);
      transform: translateX(-50%);
    }

    .nav__item:focus-visible {
      outline: none;
      background: var(--color-surface-hover);
    }

    .nav__actions {
      display: flex;
      flex: 0 0 auto;
      padding-left: 0.3rem;
      border-left: 1px solid var(--color-border);
      margin-left: 0;
    }

    .nav__theme {
      width: 2.45rem;
      height: 2.45rem;
    }

    .nav__cv {
      display: none; /* Ocultamos descargar CV en navbar mobile para priorizar íconos del tema y menú */
    }
  }

  @media (max-width: 380px) {
    .nav {
      max-width: calc(100dvw - 0.75rem);
    }

    .nav__inner {
      max-width: calc(100dvw - 0.75rem);
      padding: 0.3rem;
      gap: 0.2rem;
    }

    .nav__menu {
      gap: 0.1rem;
    }

    .nav__item {
      width: 2.25rem;
      height: 2.25rem;
    }

    .nav__icon {
      width: 16px;
      height: 16px;
    }

    .nav__theme {
      width: 2.25rem;
      height: 2.25rem;
    }
  }
</style>
