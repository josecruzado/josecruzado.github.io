---
import Icon from '../ui/Icon.astro';
import { SITE } from '../../lib/site';

const navItems = SITE.nav;
---

<nav class="nav" aria-label="Navegación principal">
  <div class="nav__inner">
    <ul class="nav__menu" role="list">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class="nav__item" data-nav-item aria-label={item.label}>
              <span class="nav__icon-wrapper">
                <Icon name={item.icon} size={15} class="nav__icon" />
              </span>
              <span class="nav__label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav__actions">
      <a href="/cv.pdf" class="nav__cv" download="Jose-Cruzado-CV.pdf" aria-label="Descargar CV">
        <span>CV</span>
        <Icon name="lucide:arrow-down" size={13} />
      </a>

      <button
        type="button"
        class="nav__theme"
        data-theme-toggle
        role="switch"
        aria-checked="false"
        aria-label="Cambiar tema"
      >
        <Icon name="lucide:sun" size={15} class="theme-icon theme-icon--sun" />
        <Icon name="lucide:moon" size={15} class="theme-icon theme-icon--moon" />
      </button>
    </div>
  </div>
</nav>

<script>
  const THEME_KEY = 'theme';
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  function syncToggle() {
    if (!toggle) return;
    const isLight = root.dataset.theme === 'light';
    toggle.setAttribute('aria-checked', String(isLight));
    toggle.setAttribute('aria-label', isLight ? 'Activar tema oscuro' : 'Activar tema claro');
  }
  syncToggle();

  function applyTheme() {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    localStorage.setItem(THEME_KEY, next);
    syncToggle();
  }

  toggle?.addEventListener('click', () => {
    // View Transitions API: crossfade nativo entre temas.
    // Fallback automático en browsers sin soporte (Firefox <122 al
    // momento de escribir esto). El reduce-motion desactiva la
    // transición visual respetando la preferencia del usuario.
    const supportsViewTransition =
      'startViewTransition' in document &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (supportsViewTransition) {
      (
        document as Document & { startViewTransition: (cb: () => void) => void }
      ).startViewTransition(applyTheme);
      return;
    }
    applyTheme();
  });

  // Listener de prefers-color-scheme: si el usuario nunca tocó el
  // toggle (sin valor en localStorage), seguimos el tema del SO en
  // tiempo real. Si ya eligió manualmente, su preferencia gana.
  const colorSchemeMQ = window.matchMedia('(prefers-color-scheme: light)');
  colorSchemeMQ.addEventListener('change', (event) => {
    if (localStorage.getItem(THEME_KEY)) return;
    root.dataset.theme = event.matches ? 'light' : 'dark';
    syncToggle();
  });

  // Cross-tab sync: si el usuario cambia el tema en otra pestaña,
  // esta se actualiza automáticamente. El evento storage solo dispara
  // en pestañas distintas a la que mutó localStorage — sin loops.
  window.addEventListener('storage', (event) => {
    if (event.key !== THEME_KEY || !event.newValue) return;
    if (event.newValue !== root.dataset.theme) {
      root.dataset.theme = event.newValue;
      syncToggle();
    }
  });

  const items = document.querySelectorAll<HTMLAnchorElement>('[data-nav-item]');
  const sections = document.querySelectorAll<HTMLElement>('main section[data-nav-section]');
  const nav = document.querySelector<HTMLElement>('.nav');

  // El smooth scroll de los clicks lo maneja el handler global de
  // scripts/smooth-scroll.ts vía event delegation. Aquí solo nos
  // ocupamos del scroll-spy (active state) y del auto-hide del nav.

  function setActiveNav(id: string | null) {
    items.forEach((item) => {
      const isActive = item.getAttribute('href') === `#${id}`;
      item.classList.toggle('is-active', isActive);
      // "location" es el valor WAI-ARIA correcto para scroll-spy
      // en navegación one-page (vs "page" que aplica a multi-page).
      if (isActive) item.setAttribute('aria-current', 'location');
      else item.removeAttribute('aria-current');
    });
  }

  // Scroll-spy via IntersectionObserver — compositor-thread, sin polling
  // de offsetTop (que causaba reflow en cada scroll tick → lag visible).
  // rootMargin define una banda virtual: cuando una section cruza la zona
  // 35–55% del viewport, se activa. Patrón Apple para one-page.
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('data-nav-section');
          setActiveNav(id);
        }
      }
    },
    {
      rootMargin: '-35% 0px -55% 0px',
      threshold: 0,
    }
  );

  sections.forEach((section) => sectionObserver.observe(section));

  // Scroll handler reducido: solo controla auto-hide del nav.
  // El active state lo maneja el observer arriba (cero reflow).
  let lastY = window.scrollY;
  let ticking = false;

  function handleScroll() {
    const y = window.scrollY;
    const delta = y - lastY;
    // Suprimir el auto-hide durante smooth scroll programático
    // (anchor clicks). El flag lo setea scripts/smooth-scroll.ts y lo
    // limpia tras ~1.2s. De lo contrario el nav desaparecería mientras
    // el usuario está navegando por click de menú.
    const isProgrammaticScroll = document.documentElement.classList.contains('is-smooth-scrolling');

    if (Math.abs(delta) > 10 && nav && !isProgrammaticScroll) {
      const shouldHide = delta > 0 && y > 180;
      nav.classList.toggle('is-hidden', shouldHide);
    }
    lastY = y;
    ticking = false;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        requestAnimationFrame(handleScroll);
        ticking = true;
      }
    },
    { passive: true }
  );
</script>

<style>
  .nav {
    position: fixed;
    /* env(safe-area-inset-top) cubre notch / Dynamic Island en iOS
       cuando hay viewport-fit=cover (lo declara SEO.astro). */
    top: calc(1.25rem + env(safe-area-inset-top, 0px));
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--z-nav);
    transition:
      transform var(--duration-base) var(--ease-out),
      opacity var(--duration-base) var(--ease-out);
  }

  .nav.is-hidden {
    transform: translateX(-50%) translateY(-120%);
    opacity: 0;
    pointer-events: none;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    /* Blur estable de 8px (antes 12px): reducción de ~44% del cost
       del backdrop-filter por frame de scroll, sin el "pop" visible
       que generaba toggle on/off entre estados. El background queda
       constante para que no haya cambio perceptible al iniciar/terminar
       scroll. Combinado con contain: paint, el nav se compone en su
       propia capa GPU y el blur se cachea entre frames cuando el
       contenido detrás no se mueve. */
    background: color-mix(in srgb, var(--color-bg-elevated) 92%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.4rem 0.5rem 0.4rem 0.65rem;
    /* Aísla el paint del nav del resto del documento: el browser no
       recalcula layout/paint de elementos hijos al cambiar fuera de
       este contenedor. Combinado con position: fixed, promueve el
       nav a su propia capa GPU. */
    contain: layout paint style;
  }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline: 0.35rem;
  }

  .nav__item {
    display: inline-flex;
    align-items: center;
    gap: 0;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    color: var(--color-fg-muted);
    font-size: 0.8125rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.01em;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  /* Desktop: solo labels (typography-first, Apple.com style).
     Ocultamos el WRAPPER (no el .nav__icon directo) porque el SVG
     renderizado por astro-icon no recibe el data-astro-cid del
     FloatingNav → un selector .nav__icon scoped no matchea al SVG.
     El wrapper sí pertenece a este componente y tiene scoping correcto.
     En mobile se invierte: wrapper visible, label oculto. */
  .nav__icon-wrapper {
    display: none;
  }

  .nav__item:hover {
    color: var(--color-fg);
    background: var(--color-surface-hover);
  }

  /* Item activo: pill con fondo accent-soft. Reemplaza el underline.
     Es más visible, más Apple-canonical, y se anima suave con background-color. */
  .nav__item.is-active {
    color: var(--color-fg);
    background: var(--color-accent-soft);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding-left: 0.4rem;
    border-left: 1px solid var(--color-border);
  }

  .nav__cv {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .nav__cv:hover {
    background: var(--color-fg);
    color: var(--color-bg);
  }

  .nav__theme {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-full);
    color: var(--color-fg-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }
  .nav__theme:hover {
    color: var(--color-fg);
  }
  .nav__theme :global(.theme-icon) {
    position: absolute;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }
  :global([data-theme='dark']) .nav__theme :global(.theme-icon--moon) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  :global([data-theme='light']) .nav__theme :global(.theme-icon--sun) {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  /* ------------------------------- Responsive */
  @media (max-width: 768px) {
    .nav {
      top: calc(0.75rem + env(safe-area-inset-top, 0px));
      bottom: auto;
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      width: max-content;
      max-width: calc(100dvw - 1rem);
      /* contain: layout (sin paint) — paint generaría overflow:hidden
         implícito que puede interferir con el transform translateY(-140%)
         del estado is-hidden. layout es suficiente para aislar layout
         recalcs en mobile. */
      contain: layout;
    }

    .nav.is-hidden {
      transform: translateX(-50%) translateY(-140%);
      opacity: 0;
      pointer-events: none;
    }

    .nav__inner {
      justify-content: center;
      width: max-content;
      max-width: calc(100dvw - 1rem);
      padding: 0.35rem;
      border-radius: var(--radius-full);
      gap: 0.3rem;
      box-shadow: none;
    }

    .nav__menu {
      flex: 0 1 auto;
      justify-content: center;
      gap: 0.2rem;
      margin-inline: 0;
    }

    .nav__item {
      width: 2.45rem;
      height: 2.45rem;
      padding: 0;
      flex-direction: row;
      min-width: auto;
      flex: 0 0 auto;
      justify-content: center;
      border-radius: var(--radius-full);
      gap: 0;
      transition:
        background-color var(--duration-fast) var(--ease-out),
        color var(--duration-fast) var(--ease-out);
      -webkit-tap-highlight-color: transparent;
    }

    .nav__icon-wrapper {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      width: auto;
      height: auto;
    }

    .nav__icon {
      display: block;
      width: 17px;
      height: 17px;
    }

    .nav__label {
      display: none;
    }

    /* Mobile: anula el pill background del desktop, usa color accent
       en el icono + dot indicador anclado al wrapper. */
    .nav__item.is-active {
      color: var(--color-accent);
      background: transparent;
      box-shadow: none;
    }

    .nav__item.is-active .nav__icon-wrapper {
      position: relative;
    }

    .nav__item.is-active .nav__icon-wrapper::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: -0.45rem;
      width: 0.25rem;
      height: 0.25rem;
      border-radius: var(--radius-full);
      background: var(--color-accent);
      transform: translateX(-50%);
    }
    /* Sin override de focus-visible aquí — el global de reset.css
       (outline 2px accent + offset 3px) da un indicador WCAG-compliant
       que también funciona dentro del nav. */

    .nav__actions {
      display: flex;
      flex: 0 0 auto;
      padding-left: 0.3rem;
      border-left: 1px solid var(--color-border);
      margin-left: 0;
    }

    .nav__theme {
      width: 2.45rem;
      height: 2.45rem;
    }

    .nav__cv {
      display: none; /* Ocultamos descargar CV en navbar mobile para priorizar íconos del tema y menú */
    }
  }

  @media (max-width: 380px) {
    .nav {
      max-width: calc(100dvw - 0.75rem);
    }

    .nav__inner {
      max-width: calc(100dvw - 0.75rem);
      padding: 0.3rem;
      gap: 0.2rem;
    }

    .nav__menu {
      gap: 0.1rem;
    }

    .nav__item {
      width: 2.25rem;
      height: 2.25rem;
    }

    .nav__icon {
      width: 16px;
      height: 16px;
    }

    .nav__theme {
      width: 2.25rem;
      height: 2.25rem;
    }
  }
</style>
