---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import memoji from '../../assets/memoji.png';
---

<Section id="inicio" fullHeight ariaLabel="Inicio">
  <div class="hero">
    <div class="hero__content">
      <p class="hero__meta">
        <span class="hero__status" aria-hidden="true"></span>
        Disponible para roles <span class="highlight">Senior Backend</span> · Remoto · Lima, Perú
      </p>

      <h1 class="hero__title display">
        <span class="hero__name">José Cruzado.</span>
        <span class="hero__role">
          Senior <em class="tech-glow">Java</em><br />Developer.
        </span>
      </h1>

      <p class="hero__statement">
        Construyo microservicios de misión crítica para banca, riesgo crediticio y retail.
        Especializado en <span class="badge-text">Spring Boot</span>, <span class="badge-text"
          >Quarkus</span
        > y arquitecturas orientadas a eventos con <span class="badge-text">Kafka</span> sobre <span
          class="badge-text">AWS/Azure</span
        >.
      </p>

      <div class="hero__actions">
        <Button href="/cv.pdf" download="Jose-Cruzado-CV.pdf" variant="primary" size="lg">
          Descargar CV
          <Icon name="lucide:arrow-down" size={16} />
        </Button>
        <Button href="#experiencia" variant="secondary" size="lg">
          Ver experiencia
          <Icon name="lucide:briefcase" size={16} />
        </Button>
        <Button href="#contacto" variant="link">Contactar</Button>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__avatar-wrapper">
        <img
          src={memoji.src}
          alt="José Cruzado Avatar"
          class="hero__avatar"
          width="280"
          height="280"
          loading="eager"
        />
        <div class="hero__avatar-backdrop"></div>
      </div>
    </div>
  </div>

  <div class="hero__scroll-hint" aria-hidden="true">
    <span>Scroll</span>
    <span class="hero__scroll-line"></span>
  </div>
</Section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 100%;
    padding-block: var(--space-16) var(--space-12);
    position: relative;
    z-index: 1;
  }

  @media (min-width: 900px) {
    .hero {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: var(--space-12);
      align-items: center;
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
  }

  .hero__visual {
    display: flex;
    justify-content: center;
    align-items: center;
    order: -1;
    margin-bottom: var(--space-4);
  }

  @media (min-width: 900px) {
    .hero__visual {
      order: 0;
      margin-bottom: 0;
    }
  }

  .hero__avatar-wrapper {
    position: relative;
    width: 200px;
    height: 200px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media (min-width: 640px) {
    .hero__avatar-wrapper {
      width: 280px;
      height: 280px;
    }
  }

  .hero__avatar {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 240px;
    height: auto;
    object-fit: contain;
    /* Efecto de PNG transparente con resplandor técnico cyan */
    filter: drop-shadow(0 15px 25px rgba(6, 182, 212, 0.25));
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-15px);
    }
  }

  .hero__avatar-backdrop {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background: radial-gradient(circle at center, var(--color-accent-soft) 0%, transparent 70%);
    filter: blur(20px);
    z-index: 1;
    animation: pulse-glow 4s ease-in-out infinite alternate;
  }

  @keyframes pulse-glow {
    0% {
      transform: scale(0.9);
      opacity: 0.5;
    }
    100% {
      transform: scale(1.1);
      opacity: 0.8;
    }
  }

  .hero__meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-subtle);
    letter-spacing: 0.02em;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    backdrop-filter: blur(8px);
  }

  .highlight {
    color: var(--color-fg);
    font-weight: var(--weight-medium);
  }

  .hero__status {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
    animation: pulse-soft 2.4s ease-in-out infinite;
  }

  @keyframes pulse-soft {
    0%,
    100% {
      box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(16, 185, 129, 0.05);
    }
  }

  .hero__title {
    font-size: var(--text-6xl);
    line-height: 0.98;
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .hero__name {
    display: block;
    font-weight: var(--weight-semibold);
    color: var(--color-fg);
  }

  .hero__role {
    display: block;
    margin-top: 0.15em;
    color: var(--color-fg-muted);
  }

  .tech-glow {
    font-style: normal;
    color: var(--color-accent);
    text-shadow: 0 0 24px var(--color-accent-ring);
    position: relative;
    display: inline-block;
  }

  .tech-glow::after {
    content: '';
    position: absolute;
    bottom: 0.1em;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--color-accent);
    opacity: 0.5;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.6s var(--ease-out);
    animation: slide-in 1s var(--ease-out) forwards 0.8s;
  }

  @keyframes slide-in {
    to {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  .hero__statement {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
    max-width: 44rem;
    font-weight: var(--weight-regular);
  }

  .badge-text {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-fg);
    background: var(--color-surface);
    padding: 0.1rem 0.3rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
    margin-top: var(--space-6);
  }

  .hero__scroll-hint {
    position: absolute;
    bottom: var(--space-8);
    right: var(--container-padding);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-fg-faint);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .hero__scroll-line {
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(to top, transparent, var(--color-fg-faint));
    animation: scroll-line 2.5s ease-in-out infinite;
  }

  @keyframes scroll-line {
    0%,
    100% {
      transform: scaleY(1);
      transform-origin: bottom;
      opacity: 1;
    }
    50% {
      transform: scaleY(0.4);
      transform-origin: bottom;
      opacity: 0.3;
    }
  }

  @media (max-width: 640px) {
    .hero__scroll-hint {
      display: none;
    }
    .hero {
      gap: var(--space-6);
      padding-block: var(--space-20) var(--space-8);
    }

    .hero__content {
      gap: var(--space-6);
      align-items: center;
      text-align: center;
    }

    .hero__visual {
      margin-bottom: 0;
    }

    .hero__avatar-wrapper {
      width: 148px;
      height: 148px;
    }

    .hero__avatar {
      max-width: 168px;
      animation: none;
    }

    .hero__meta {
      align-items: flex-start;
      justify-content: center;
      white-space: normal;
      line-height: var(--leading-snug);
      text-align: left;
    }

    .hero__title {
      font-size: clamp(2.45rem, 14vw, 3.4rem);
    }

    .hero__statement {
      font-size: var(--text-base);
      line-height: var(--leading-normal);
      max-width: 32rem;
    }

    .hero__actions {
      width: 100%;
      max-width: 22rem;
      justify-content: center;
      gap: var(--space-4);
      margin-top: var(--space-2);
    }

    .hero__actions :global(.btn) {
      width: 100%;
      min-height: 2.9rem;
      white-space: normal;
    }
  }
</style>
