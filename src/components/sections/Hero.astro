---
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { SITE } from '../../lib/site';
import memoji from '../../assets/memoji.png';
---

<Section id="inicio" fullHeight ariaLabel="Inicio">
  <div class="hero">
    <div class="hero__content">
      <p class="hero__meta">
        <span class="hero__status" aria-hidden="true"></span>
        Disponible para roles <span class="highlight">Senior Backend</span> · Remoto · Lima, Perú
      </p>

      <h1 class="hero__title display">
        <span class="hero__name">José Cruzado.</span>
        <span class="hero__role">
          Senior <em class="tech-glow">Java</em><br />Developer.
        </span>
      </h1>

      <p class="hero__statement">
        Construyo microservicios de misión crítica para banca, riesgo crediticio y retail.
        Especializado en <span class="badge-text">Spring Boot</span>, <span class="badge-text"
          >Quarkus</span
        > y arquitecturas orientadas a eventos con <span class="badge-text">Kafka</span> sobre <span
          class="badge-text">AWS/Azure</span
        >.
      </p>

      <dl class="hero__stats" aria-label="Resumen de impacto">
        {
          SITE.stats.map((stat) => (
            <div class="hero__stat">
              <dt class="hero__stat-label">{stat.label}</dt>
              <dd>
                <span class="hero__stat-value">{stat.value}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="hero__actions">
        <Button href="/cv.pdf" download="Jose-Cruzado-CV.pdf" variant="primary" size="lg">
          Descargar CV
          <Icon name="lucide:download" size={16} />
        </Button>
        <Button href="#proyectos" variant="secondary" size="lg">
          Ver proyectos
          <Icon name="lucide:arrow-right" size={16} />
        </Button>
        <Button href="#contacto" variant="link">Contactar</Button>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__avatar-wrapper">
        <Image
          src={memoji}
          alt="José Cruzado, Senior Backend Java Developer"
          class="hero__avatar"
          widths={[140, 280, 400]}
          sizes="(min-width: 640px) 280px, 132px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          format="webp"
          quality={88}
        />
        <div class="hero__avatar-backdrop"></div>
      </div>
    </div>
  </div>

  <div class="hero__scroll-hint" aria-hidden="true">
    <span>Scroll</span>
    <span class="hero__scroll-line"></span>
  </div>
</Section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 100%;
    padding-block: var(--space-16) var(--space-12);
    position: relative;
    z-index: 1;
  }

  @media (min-width: 900px) {
    .hero {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: var(--space-12);
      align-items: center;
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
  }

  .hero__visual {
    display: flex;
    justify-content: center;
    align-items: center;
    order: -1;
    margin-bottom: var(--space-4);
  }

  @media (min-width: 900px) {
    .hero__visual {
      order: 0;
      margin-bottom: 0;
    }
  }

  .hero__avatar-wrapper {
    position: relative;
    width: 200px;
    height: 200px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media (min-width: 640px) {
    .hero__avatar-wrapper {
      width: 280px;
      height: 280px;
    }
  }

  .hero__avatar {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 240px;
    height: auto;
    object-fit: contain;
    /* Efecto de PNG transparente con resplandor técnico cyan */
    filter: drop-shadow(0 15px 25px rgba(6, 182, 212, 0.25));
    animation: float 6s ease-in-out infinite;
    /* translateZ promueve el avatar a su propia capa GPU. drop-shadow
       es un filter caro de recomponer; si el avatar comparte layer con
       el body, durante scroll la sombra se repinta con ligero retraso
       respecto al elemento (visible como "ghost"/sombra extraña).
       En su propia capa, la sombra se cachea como textura y solo se
       traslada con el scroll. backface-visibility refuerza la promoción. */
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  /* Keyframes con translate3d para mantener la promoción a capa GPU
     durante toda la animación. Sin Z, algunos browsers podían
     desactivar la promoción a mid-animation si determinaban que
     translateY es 2D-only. */
  @keyframes float {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -15px, 0);
    }
  }

  .hero__avatar-backdrop {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background: radial-gradient(circle at center, var(--color-accent-soft) 0%, transparent 70%);
    filter: blur(20px);
    z-index: 1;
    animation: pulse-glow 4s ease-in-out infinite alternate;
  }

  @keyframes pulse-glow {
    0% {
      transform: scale(0.9);
      opacity: 0.5;
    }
    100% {
      transform: scale(1.1);
      opacity: 0.8;
    }
  }

  .hero__meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-subtle);
    letter-spacing: 0.02em;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    backdrop-filter: blur(8px);
  }

  .highlight {
    color: var(--color-fg);
    font-weight: var(--weight-medium);
  }

  .hero__status {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    /* Anillo estático base — el efecto pulsante se delega al ::before
       de abajo, que usa transform/opacity (GPU-accelerated) en vez de
       box-shadow animado (paint-heavy, no GPU). */
    box-shadow: 0 0 0 4px var(--color-success-ring);
    flex-shrink: 0;
  }

  /* ::before genera el anillo expansivo que pulsa. Vive en z-index: -1
     (debajo del dot) y se escala con transform. La opacidad va de 1→0
     en el medio del ciclo, simulando un onda que se desvanece.
     Visualmente equivalente al pattern anterior de box-shadow, pero
     compositor-friendly: en mobile y monitores 144Hz el cost de paint
     por frame es ~0 frente a los ~1-2ms del box-shadow original. */
  .hero__status::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: var(--color-success-ring);
    z-index: -1;
    animation: pulse-soft 2.4s ease-in-out infinite;
  }

  @keyframes pulse-soft {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .hero__title {
    font-size: var(--text-6xl);
    line-height: 0.98;
    letter-spacing: var(--tracking-tight);
    margin: 0;
    /* balance evita que la última línea quede huérfana de 1–2 palabras,
       crítico en headings editoriales de 2 líneas. Baseline 2024. */
    text-wrap: balance;
  }

  .hero__name {
    display: block;
    font-weight: var(--weight-semibold);
    color: var(--color-fg);
  }

  .hero__role {
    display: block;
    margin-top: 0.15em;
    color: var(--color-fg-muted);
  }

  .tech-glow {
    font-style: normal;
    color: var(--color-accent);
    text-shadow: 0 0 24px var(--color-accent-ring);
    position: relative;
    display: inline-block;
  }

  .tech-glow::after {
    content: '';
    position: absolute;
    bottom: 0.1em;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--color-accent);
    opacity: 0.5;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.6s var(--ease-out);
    animation: slide-in 1s var(--ease-out) forwards 0.8s;
  }

  @keyframes slide-in {
    to {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  .hero__statement {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
    max-width: 44rem;
    font-weight: var(--weight-regular);
    /* pretty mejora el wrap del párrafo evitando líneas finales cortas,
       sin alterar la altura como sí lo haría balance en multi-línea. */
    text-wrap: pretty;
  }

  .badge-text {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-fg);
    background: var(--color-surface);
    padding: 0.1rem 0.3rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, max-content));
    gap: var(--space-8);
    margin: 0;
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    width: 100%;
    max-width: 36rem;
  }

  .hero__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
    min-width: 0;
  }

  /* display: contents — la <dd> participa semánticamente en el <dl>
     (par dt/dd válido para screen readers) pero NO genera caja propia.
     El <span class="hero__stat-value"> hijo se convierte en flex item
     directo de .hero__stat, heredando todos los estilos previos sin
     reasignarlos. Baseline ampliamente disponible 2018+ (Chrome 65,
     Safari 11.1, Firefox 37). */
  .hero__stat dd {
    display: contents;
    margin: 0;
  }

  .hero__stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.3rem + 1.2vw, 2.25rem);
    font-weight: var(--weight-semibold);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-fg);
    margin: 0;
  }

  .hero__stat-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-fg-subtle);
    line-height: var(--leading-snug);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
    margin-top: var(--space-2);
  }

  /* Scroll hint — texto vertical leíble de abajo→arriba + línea
     animada apuntando hacia el contenido. El writing-mode se aplica
     SOLO al texto, no al contenedor flex (de lo contrario flex-direction
     column se invierte a horizontal en screen space, rompiendo el
     layout vertical).

     Visibilidad: oculto por default, se muestra SOLO cuando el Hero
     activa su grid 2-col (≥900px) — antes de eso el contenido del
     hero ocupa todo el ancho y el hint solaparía con CTAs / stats. */
  .hero__scroll-hint {
    display: none;
    position: absolute;
    bottom: var(--space-10);
    right: var(--space-6);
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .hero__scroll-hint {
      display: flex;
    }
  }

  .hero__scroll-hint > span:first-child {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--color-fg-subtle);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .hero__scroll-line {
    width: 1px;
    height: 4rem;
    background: linear-gradient(to bottom, transparent, var(--color-fg-subtle));
    animation: scroll-line 2.5s ease-in-out infinite;
  }

  @keyframes scroll-line {
    0%,
    100% {
      transform: scaleY(1);
      transform-origin: bottom;
      opacity: 1;
    }
    50% {
      transform: scaleY(0.4);
      transform-origin: bottom;
      opacity: 0.3;
    }
  }

  /* Respeto integral de reduced-motion en cualquier viewport: las
     animaciones decorativas (float, pulse-glow, slide-in, scroll-line,
     pulse-soft) no deben ejecutarse si el usuario las desactiva. La
     regla anterior solo cubría mobile vía override de animation: none. */
  @media (prefers-reduced-motion: reduce) {
    .hero__avatar,
    .hero__avatar-backdrop,
    .hero__status::before,
    .hero__scroll-line,
    .tech-glow::after {
      animation: none;
    }
    .tech-glow::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  @media (max-width: 640px) {
    .hero {
      /* Padding y gap reducidos para que los CTAs entren en el
         primer pliegue de mobile (iPhone 14 ~750px disponibles).
         Antes: padding 4rem/2.5rem + gap 1.25rem dejaba ~826px de
         contenido (los botones quedaban fuera del viewport). */
      gap: var(--space-4);
      padding-block: var(--space-8) var(--space-6);
    }

    .hero__content {
      gap: var(--space-4);
      align-items: center;
      text-align: center;
      width: 100%;
    }

    .hero__visual {
      margin-bottom: 0;
    }

    .hero__avatar-wrapper {
      width: 116px;
      height: 116px;
    }

    .hero__avatar {
      max-width: 132px;
      animation: none;
      filter: drop-shadow(0 8px 16px rgba(6, 182, 212, 0.22));
    }

    .hero__avatar-backdrop {
      animation: none;
      opacity: 0.6;
    }

    .hero__meta {
      justify-content: center;
      white-space: normal;
      line-height: var(--leading-snug);
      max-width: 100%;
    }

    .hero__title {
      font-size: clamp(2.25rem, 13vw, 3.2rem);
    }

    .hero__statement {
      font-size: var(--text-base);
      line-height: var(--leading-normal);
      max-width: 34rem;
    }

    .hero__statement .badge-text {
      white-space: nowrap;
    }

    .hero__actions {
      width: 100%;
      max-width: 22rem;
      justify-content: center;
      gap: var(--space-3);
      margin-top: var(--space-1);
    }

    .hero__actions :global(.btn:not(.btn--link)) {
      width: 100%;
      min-height: 2.9rem;
      white-space: normal;
    }

    .hero__actions :global(.btn--link) {
      width: auto;
      margin-top: var(--space-1);
    }

    /* Mobile: stack vertical con valor + label inline en cada fila.
       Resuelve el wrap descoordinado de labels largas en 3 columnas. */
    .hero__stats {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      max-width: 22rem;
      align-self: center;
      width: 100%;
    }

    /* row-reverse: dd (value) primero visual, dt (label) después.
       Mantiene el orden DOM dt → dd (semánticamente correcto para
       screen readers) y entrega el patrón "stat card" clásico:
       número a la izquierda, descripción a la derecha. */
    .hero__stat {
      flex-direction: row-reverse;
      align-items: baseline;
      gap: var(--space-4);
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .hero__stat:last-child {
      border-bottom: 0;
    }

    .hero__stat-value {
      font-size: var(--text-xl);
      flex-shrink: 0;
      color: var(--color-accent);
      min-width: 2.5rem;
      text-align: left;
    }

    .hero__stat-label {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-align: left;
      flex: 1;
      min-width: 0;
    }
  }
</style>
