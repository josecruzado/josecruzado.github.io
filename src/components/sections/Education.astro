---
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import { EDUCATION } from '../../lib/education';
import { SITE } from '../../lib/site';

const typeLabels: Record<string, string> = {
  degree: 'Grado',
  certification: 'Certificación',
  course: 'Curso',
  language: 'Idioma',
};
---

<Section id="educacion" ariaLabel="Educación y certificaciones">
  <header class="section-header">
    <p class="eyebrow">05 · Formación</p>
    <h2 class="section-heading display">Educación y certificaciones para backend moderno.</h2>
  </header>

  <ul class="education" role="list">
    {
      EDUCATION.map((item) => (
        <Card as="li" class="education__item">
          <span class="education__icon" aria-hidden="true">
            <Icon name={item.icon} size={22} />
          </span>
          <div class="education__body">
            <div class="education__meta">
              <Badge variant="accent">{typeLabels[item.type]}</Badge>
              <time class="education__period">{item.period}</time>
            </div>
            <h3 class="education__title">{item.title}</h3>
            <p class="education__institution">{item.institution}</p>
          </div>
        </Card>
      ))
    }
  </ul>

  <aside class="languages" aria-label="Idiomas">
    <h3 class="languages__title">
      <Icon name="lucide:languages" size={18} />
      Idiomas
    </h3>
    <ul class="languages__list" role="list">
      {
        SITE.author.languages.map((lang) => (
          <li class="languages__item">
            <strong>{lang.name}</strong>
            <span class="languages__level">{lang.level}</span>
          </li>
        ))
      }
    </ul>
  </aside>
</Section>

<style>
  .section-header {
    margin-bottom: var(--space-12);
    max-width: 48rem;
  }

  .section-heading {
    font-size: var(--text-3xl);
    line-height: 1.1;
    margin-top: var(--space-4);
  }

  .education {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .education__item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .education__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent-ring);
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .education__body {
    flex: 1;
    min-width: 0;
  }

  .education__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }

  .education__period {
    color: var(--color-fg-subtle);
    font-size: var(--text-xs);
  }

  .education__title {
    font-size: var(--text-base);
    font-weight: 700;
    margin-bottom: 0.15rem;
    line-height: 1.3;
  }

  .education__institution {
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }

  .languages {
    margin-top: var(--space-12);
    max-width: 32rem;
    margin-inline: auto;
    text-align: center;
  }

  .languages__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    font-weight: 700;
    margin-bottom: var(--space-4);
    color: var(--color-accent);
  }

  .languages__list {
    display: flex;
    justify-content: center;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .languages__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .languages__item strong {
    font-size: var(--text-lg);
  }
  .languages__level {
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 720px) {
    .education {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .section-header {
      margin-bottom: var(--space-8);
    }

    .section-heading {
      font-size: var(--text-2xl);
    }

    .education__item {
      gap: var(--space-3);
    }

    .education__icon {
      width: 2.35rem;
      height: 2.35rem;
    }

    .education__meta {
      gap: var(--space-2);
    }

    .languages {
      margin-top: var(--space-8);
      text-align: left;
    }

    .languages__list {
      justify-content: flex-start;
      gap: var(--space-6);
    }
  }
</style>
