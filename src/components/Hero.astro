---
import { Image } from 'astro:assets';

// Hero component - Landing section
const stats = [
  { number: '6+', label: 'Años Exp.' },
  { number: '15+', label: 'Proyectos' },
  { number: '1M+', label: 'Usuarios' }
];

const skills = [
  'Java',
  'Spring Boot',
  'Microservicios',
  'Docker'
];
---

<!-- Hero Section -->
<section id="inicio" class="hero">
  <div class="hero-bg">
    <div class="hero-circle hero-circle-1"></div>
    <div class="hero-circle hero-circle-2"></div>
  </div>

  <div class="hero-content">

    <div class="hero-intro">
      <Image 
        src="/memoji.png" 
        alt="José Cruzado" 
        width={64}
        height={64}
        class="memoji" 
      />
      <h1 class="hero-title">
        José Cruzado
        <span class="hero-title-gradient">
          Senior Backend Java Developer
        </span>
      </h1>
    </div>

    <p class="hero-subtitle">
      Construyendo sistemas escalables y de alto rendimiento
    </p>

    <!-- Stats -->
    <div class="stats-grid">
      {stats.map(stat => (
        <div class="stat-item">
          <div class="stat-number">
            {stat.number}
          </div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- CTA Buttons -->
    <div class="hero-buttons">
      <a href="#proyectos" class="btn btn-primary hero-btn">
        Ver Proyectos
        <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
      <a href="/cv.pdf" class="btn btn-secondary hero-btn">
        <svg class="btn-icon-left" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        Descargar CV
      </a>
    </div>

    <!-- Tech Stack -->
    <div class="tech-stack">
      {skills.map(skill => (
        <span class="tech-badge">
          {skill}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
/* Hero Section */
.hero {
  min-height: 100vh;
  min-height: 100dvh; /* Dynamic viewport height para mejor soporte mobile */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rem 1.5rem 6rem 1.5rem;
  position: relative;
  overflow: hidden;
  width: 100%;
}

.hero-bg {
  position: absolute;
  inset: 0;
}

.hero-circle {
  position: absolute;
  width: 24rem;
  height: 24rem;
  border-radius: 50%;
  filter: blur(60px);
  animation: pulse 4s ease-in-out infinite;
}

.hero-circle-1 {
  top: 25%;
  left: 25%;
  background: rgba(6, 182, 212, 0.2);
}

.hero-circle-2 {
  bottom: 25%;
  right: 25%;
  background: rgba(59, 130, 246, 0.2);
  animation-delay: 2s;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.4;
  }
}

.hero-content {
  max-width: 80rem;
  text-align: center;
  position: relative;
  z-index: 10;
  width: 100%;
}

.hero-badge {
  display: inline-block;
  margin-bottom: 1rem;
  padding: 0.5rem 1rem;
  background: rgba(6, 182, 212, 0.1);
  border: 1px solid rgba(6, 182, 212, 0.2);
  border-radius: 50px;
  color: #06b6d4;
  font-size: 0.875rem;
  font-weight: 600;
}

.hero-intro {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
  margin-bottom: 1.5rem;
}

.memoji {
  width: 4rem;
  height: 4rem;
  border-radius: 50%;
  box-shadow: 0 8px 20px rgba(6, 182, 212, 0.15);
}

.hero-title {
  font-size: 3rem;
  font-weight: bold;
  margin-bottom: 0;
  line-height: 1.1;
}

.hero-title-gradient {
  display: block;
  background: linear-gradient(135deg, #06b6d4, #3b82f6, #8b5cf6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-subtitle {
  font-size: 1.25rem;
  color: #9ca3af;
  margin-bottom: 3rem;
  max-width: 48rem;
  margin-left: auto;
  margin-right: auto;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin-bottom: 3rem;
  max-width: 32rem;
  margin-left: auto;
  margin-right: auto;
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: 2rem;
  font-weight: bold;
  background: linear-gradient(135deg, #06b6d4, #3b82f6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 0.5rem;
}

.stat-label {
  font-size: 0.875rem;
  color: #6b7280;
}

.hero-buttons {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  justify-content: center;
  margin-bottom: 3rem;
}

.hero-btn {
  padding: 1rem 2rem;
  font-size: 1rem;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.75rem 1.5rem;
  border-radius: 0.5rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
  border: none;
  cursor: pointer;
}

.btn-primary {
  background: linear-gradient(135deg, #06b6d4, #3b82f6);
  color: white;
  box-shadow: 0 4px 14px rgba(6, 182, 212, 0.3);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(6, 182, 212, 0.4);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.1);
  color: #e5e7eb;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.btn-secondary:hover {
  background: rgba(255, 255, 255, 0.2);
  color: white;
  transform: translateY(-2px);
}

.btn-icon {
  width: 1.25rem;
  height: 1.25rem;
  margin-left: 0.5rem;
  transition: transform 0.3s;
}

.btn-icon-left {
  width: 1.25rem;
  height: 1.25rem;
  margin-right: 0.5rem;
}

.btn:hover .btn-icon {
  transform: translateX(0.25rem);
}

.tech-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  justify-content: center;
  max-width: 32rem;
  margin: 0 auto;
}

.tech-badge {
  padding: 0.5rem 1rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 50px;
  font-size: 0.875rem;
  color: #d1d5db;
}

/* Light theme styles */
:global(body.light-theme) .hero {
  background: linear-gradient(180deg, #f9fafb 0%, #e5e7eb 50%, #f9fafb 100%);
}

:global(body.light-theme) .btn-secondary {
  background: rgba(0, 0, 0, 0.05);
  color: #374151;
  border: 1px solid rgba(0, 0, 0, 0.15);
}

:global(body.light-theme) .btn-secondary:hover {
  background: rgba(6, 182, 212, 0.1);
  color: #06b6d4;
  border-color: rgba(6, 182, 212, 0.3);
}

:global(body.light-theme) .tech-badge {
  background: rgba(0, 0, 0, 0.05);
  border: 1px solid rgba(0, 0, 0, 0.1);
  color: #4b5563;
}

/* Responsive Design */
@media (max-width: 639px) {
  .hero {
    padding: 0 1rem 6rem 1rem;
  }
  
  .hero-title {
    font-size: 2.5rem !important;
  }
  
  .stats-grid {
    gap: 1rem;
  }
}

@media (min-width: 640px) {
  .hero-buttons {
    flex-direction: row;
  }
}

@media (min-width: 768px) {
  .hero-title {
    font-size: 4rem;
  }
  
  .stat-number {
    font-size: 2.5rem;
  }
  
  .hero {
    padding: 6rem 1.5rem 4rem 1.5rem;
  }
}

@media (min-width: 1024px) {
  .hero-title {
    font-size: 5rem;
  }
}

@media (min-width: 1280px) {
  .hero-title {
    font-size: 6rem;
  }
}

/* Additional mobile adjustments */
@media (max-width: 480px) {
  .hero {
    padding: 5rem 1rem 3rem 1rem;
  }
}
</style>