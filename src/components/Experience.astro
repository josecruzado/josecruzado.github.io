---
// Experience component - Experiencia profesional
const experience = [
  {
    period: '2024 - Presente',
    role: 'Senior Backend Java Developer',
    company: 'Tata Consultancy Services – BCP',
    achievements: [
      'Desarrollé microservicios ATM con Spring Boot y Quarkus para operaciones críticas bancarias',
      'Implementé arquitectura event-driven con Kafka para trazabilidad de transacciones',
      'Automaticé despliegues en AKS usando Jenkins y GitOps',
      'Diseñé contratos OpenAPI cumpliendo estándares de seguridad bancaria'
    ]
  },
  {
    period: '2022 - 2024',
    role: 'Java Developer Analyst',
    company: 'Manpower Professional Services – Equifax',
    achievements: [
      'Remedié vulnerabilidades críticas detectadas por Fortify y Pentest',
      'Desplegué aplicaciones en AWS ECS/ECR usando GoCD y Docker',
      'Desarrollé APIs REST y procesos ETL con Pentaho',
      'Aseguré cumplimiento de SLAs en entornos productivos'
    ]
  },
  {
    period: '2021 - 2022',
    role: 'Backend Developer',
    company: 'NTT DATA – Inditex (ZARA)',
    achievements: [
      'Desarrollé microservicios para flujos logísticos e-commerce',
      'Integré servicios con couriers usando Spring Boot',
      'Implementé pruebas unitarias e integración con Traffic Parrot',
      'Participé activamente en code reviews y calidad de código'
    ]
  }
];
---

<!-- Experience -->
<section id="experiencia" class="experience">
  <div class="container">
    <h2 class="section-title-center">
      Trayectoria
      <span class="section-subtitle">Experiencia Profesional</span>
    </h2>

    <div class="experience-list">
      {experience.map(job => (
        <div class="experience-item">
          <div class="experience-line"></div>
          
          <div class="experience-content">
            <div class="experience-header">
              <div class="experience-info">
                <h3 class="experience-role">{job.role}</h3>
                <div class="experience-company">{job.company}</div>
              </div>
              <div class="experience-period">{job.period}</div>
            </div>
            
            <ul class="experience-achievements">
              {job.achievements.map(achievement => (
                <li class="achievement-item">
                  <span class="achievement-bullet">▹</span>
                  <span>{achievement}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
/* Experience Section */
.experience {
  min-height: 100vh;
  min-height: 100dvh; /* Dynamic viewport height para mejor soporte mobile */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 0;
  background: linear-gradient(180deg, #111827 0%, #1f2937 50%, #374151 100%);
  position: relative;
  overflow: hidden;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  position: relative;
  z-index: 10;
  width: 100%;
}

.section-title-center {
  font-size: 2.5rem;
  font-weight: bold;
  margin-bottom: 4rem;
  text-align: center;
  line-height: 1.2;
}

.section-subtitle {
  display: block;
  font-size: 1.25rem;
  color: #6b7280;
  margin-top: 0.5rem;
  font-weight: normal;
}

.experience-list {
  max-width: 64rem;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.experience-item {
  position: relative;
}

.experience-line {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 0.125rem;
  background: linear-gradient(180deg, #06b6d4, #3b82f6);
  opacity: 0.3;
}

.experience-content {
  margin-left: 2rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 1rem;
  padding: 1.5rem;
  transition: all 0.3s;
}

.experience-content:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(6, 182, 212, 0.3);
}

.experience-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 1rem;
}

.experience-role {
  font-size: 1.25rem;
  font-weight: bold;
  color: white;
  margin-bottom: 0.25rem;
}

.experience-company {
  color: #06b6d4;
  font-weight: 500;
}

.experience-period {
  font-size: 0.875rem;
  color: #6b7280;
  margin-top: 0.5rem;
}

.experience-achievements {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin: 0;
  padding: 0;
}

.achievement-item {
  display: flex;
  align-items: flex-start;
  color: #9ca3af;
  line-height: 1.6;
}

.achievement-bullet {
  color: #06b6d4;
  margin-right: 0.5rem;
  margin-top: 0.25rem;
  flex-shrink: 0;
}

/* Light theme styles */
:global(body.light-theme) .experience {
  background: linear-gradient(180deg, #f9fafb 0%, #e5e7eb 50%, #f9fafb 100%);
}

:global(body.light-theme) .section-title-center {
  color: #1f2937;
}

:global(body.light-theme) .section-subtitle {
  color: #6b7280;
}

:global(body.light-theme) .experience-content {
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(0, 0, 0, 0.1);
  color: #374151;
}

:global(body.light-theme) .experience-content:hover {
  background: rgba(255, 255, 255, 0.95);
  border-color: rgba(6, 182, 212, 0.3);
}

:global(body.light-theme) .experience-role {
  color: #1f2937;
}

:global(body.light-theme) .experience-company {
  color: #06b6d4;
}

:global(body.light-theme) .experience-period {
  color: #6b7280;
}

:global(body.light-theme) .achievement-item {
  color: #4b5563;
}

:global(body.light-theme) .achievement-bullet {
  color: #06b6d4;
}

/* Responsive Design */
@media (min-width: 768px) {
  .experience-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  
  .experience-period {
    margin-top: 0;
  }
}
</style>