---
// Contact component - Contacto y footer
---

<!-- Contact -->
<section id="contacto" class="contact">
  <div class="container">
    <div class="contact-content">
      <h2 class="contact-title">
        ¿Listo para trabajar juntos?
      </h2>
      <p class="contact-subtitle">
        Siempre abierto a discutir nuevos proyectos y oportunidades
      </p>
      
      <div class="contact-buttons">
        <a href="mailto:josecruzado.1206@gmail.com" class="btn btn-primary contact-btn">
          📧 Enviar Email
        </a>
        <a href="https://www.linkedin.com/in/josecruzado12/" class="btn btn-secondary contact-btn">
          💼 LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="footer">
  <p>© 2026 José Cruzado · Backend Developer</p>
</footer>

<style>
/* Contact Section */
.contact {
  min-height: 100vh;
  min-height: 100dvh; /* Dynamic viewport height para mejor soporte mobile */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 0;
  background: linear-gradient(180deg, #000000 0%, #111827 50%, #000000 100%);
  position: relative;
  overflow: hidden;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  position: relative;
  z-index: 10;
  width: 100%;
}

.contact-content {
  max-width: 64rem;
  margin: 0 auto;
  text-align: center;
}

.contact-title {
  font-size: 3rem;
  font-weight: bold;
  margin-bottom: 1.5rem;
  line-height: 1.1;
}

.contact-subtitle {
  font-size: 1.25rem;
  color: #9ca3af;
  margin-bottom: 3rem;
}

.contact-buttons {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  justify-content: center;
}

.contact-btn {
  padding: 1.25rem 2.5rem;
  font-size: 1.125rem;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.75rem 1.5rem;
  border-radius: 0.5rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
  border: none;
  cursor: pointer;
}

.btn-primary {
  background: linear-gradient(135deg, #06b6d4, #3b82f6);
  color: white;
  box-shadow: 0 4px 14px rgba(6, 182, 212, 0.3);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(6, 182, 212, 0.4);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.1);
  color: #e5e7eb;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.btn-secondary:hover {
  background: rgba(255, 255, 255, 0.2);
  color: white;
  transform: translateY(-2px);
}

/* Footer */
.footer {
  padding: 2rem 0;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  text-align: center;
  color: #6b7280;
}

/* Light theme styles */
:global(body.light-theme) .contact {
  background: linear-gradient(180deg, #f9fafb 0%, #e5e7eb 50%, #f9fafb 100%);
}

:global(body.light-theme) .contact-title {
  color: #1f2937;
}

:global(body.light-theme) .contact-subtitle {
  color: #6b7280;
}

:global(body.light-theme) .btn-secondary {
  background: rgba(0, 0, 0, 0.1);
  color: #374151;
  border: 1px solid rgba(0, 0, 0, 0.2);
}

:global(body.light-theme) .btn-secondary:hover {
  background: rgba(0, 0, 0, 0.2);
  color: #1f2937;
  transform: translateY(-2px);
}

:global(body.light-theme) .footer {
  border-top: 1px solid rgba(0, 0, 0, 0.1);
  color: #6b7280;
}

/* Responsive Design */
@media (min-width: 640px) {
  .contact-buttons {
    flex-direction: row;
  }
}

@media (min-width: 1024px) {
  .contact-title {
    font-size: 4rem;
  }
}
</style>