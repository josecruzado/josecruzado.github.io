---
// Floating Navigation Component
---

<!-- Floating Navigation -->
<nav class="floating-navbar">
  <div class="floating-nav-container">
    <div class="nav-brand">
      <div class="brand-icon">💻</div>
      <span class="brand-text">José Cruzado</span>
    </div>
    
    <div class="nav-divider"></div>
    
    <div class="nav-menu">
      <a href="#inicio" class="nav-item" title="Inicio">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M3 9L12 2L21 9V20A2 2 0 0 1 19 22H5A2 2 0 0 1 3 20V9Z"></path>
        </svg>
        <span class="nav-label">Inicio</span>
      </a>
      
      <a href="#sobre-mi" class="nav-item" title="Sobre mí">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M20 21V19A4 4 0 0 0 16 15H8A4 4 0 0 0 4 19V21"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span class="nav-label">Sobre mí</span>
      </a>
      
      <a href="#experiencia" class="nav-item" title="Experiencia">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
        <span class="nav-label">Experiencia</span>
      </a>
      
      <a href="#proyectos" class="nav-item" title="Proyectos">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <polyline points="16,18 22,12 16,6"></polyline>
          <polyline points="8,6 2,12 8,18"></polyline>
        </svg>
        <span class="nav-label">Proyectos</span>
      </a>
      
      <a href="#contacto" class="nav-item" title="Contacto">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M4 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4Z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <span class="nav-label">Contacto</span>
      </a>
    </div>
    
    <div class="nav-divider"></div>
    
    <div class="nav-actions">
      <a href="/cv.pdf" class="action-btn" title="Descargar CV">
        <svg class="action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M21 15V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V15"></path>
          <polyline points="7,10 12,15 17,10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      </a>
      
      <button class="theme-toggle" title="Cambiar tema" onclick="window.toggleTheme()">
        <svg class="theme-icon sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="theme-icon moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<style>
/* Floating Navigation */
.floating-navbar {
  position: fixed;
  top: 2rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1000;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.floating-nav-container {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(15, 15, 15, 0.95);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  padding: 0.75rem 1rem;
  box-shadow: 
    0 10px 32px rgba(0, 0, 0, 0.3),
    0 4px 16px rgba(0, 0, 0, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.1);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.brand-icon {
  font-size: 1.2rem;
}

.brand-text {
  font-size: 0.875rem;
  font-weight: 600;
  background: linear-gradient(135deg, #06b6d4, #3b82f6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  white-space: nowrap;
}

.nav-divider {
  width: 1px;
  height: 20px;
  background: rgba(255, 255, 255, 0.1);
}

.nav-menu {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.5rem 0.75rem;
  border-radius: 12px;
  text-decoration: none;
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.8rem;
  font-weight: 500;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.nav-item:hover {
  color: white;
  background: rgba(255, 255, 255, 0.05);
  transform: translateY(-1px);
}

.nav-item:active {
  transform: translateY(0);
}

.nav-icon {
  width: 16px;
  height: 16px;
  stroke-width: 2;
  transition: all 0.2s;
}

.nav-label {
  white-space: nowrap;
  transition: all 0.2s;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 10px;
  background: linear-gradient(135deg, #06b6d4, #3b82f6);
  color: white;
  text-decoration: none;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 2px 8px rgba(6, 182, 212, 0.2);
}

.action-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(6, 182, 212, 0.3);
}

.action-icon {
  width: 16px;
  height: 16px;
  stroke-width: 2.5;
}

.theme-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: none;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.7);
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.theme-toggle:hover {
  background: rgba(255, 255, 255, 0.1);
  color: white;
  transform: translateY(-1px);
}

.theme-icon {
  width: 14px;
  height: 14px;
  stroke-width: 2.5;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.moon-icon {
  display: none;
}

.sun-icon {
  display: block;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .floating-navbar {
    top: 1rem;
    left: 1rem;
    right: 1rem;
    transform: none;
    width: calc(100% - 2rem);
  }
  
  .floating-nav-container {
    width: 100%;
    padding: 0.75rem 0.5rem;
    justify-content: center;
  }
  
  .nav-menu {
    flex: 1;
    justify-content: center;
    gap: 0.5rem;
  }
  
  .nav-label {
    display: none;
  }
  
  .nav-item {
    padding: 0.75rem 0.5rem;
    gap: 0;
    min-width: 44px;
    min-height: 44px;
    justify-content: center;
  }
  
  .nav-icon {
    width: 18px;
    height: 18px;
  }
  
  .brand-text {
    display: none;
  }
  
  .action-btn {
    width: 36px;
    height: 36px;
  }
  
  .theme-toggle {
    width: 36px;
    height: 36px;
  }
}

@media (max-width: 480px) {
  .floating-navbar {
    top: 0.5rem;
  }
  
  .nav-brand {
    display: none;
  }
  
  .nav-divider:first-of-type {
    display: none;
  }
  
  .floating-nav-container {
    padding: 0.5rem;
    border-radius: 20px;
  }
  
  .nav-menu {
    gap: 0.25rem;
  }
  
  .nav-item {
    padding: 0.5rem 0.375rem;
    border-radius: 8px;
  }
}
</style>

<script>
// TypeScript declarations
declare global {
  interface Window {
    toggleTheme: () => void;
  }
}

// Make theme toggle function global
window.toggleTheme = function() {
  const body = document.body;
  const themeToggle = document.querySelector('.theme-toggle') as HTMLElement;
  if (!themeToggle) return;
  
  const sunIcon = themeToggle.querySelector('.sun-icon') as HTMLElement;
  const moonIcon = themeToggle.querySelector('.moon-icon') as HTMLElement;
  
  const isCurrentlyLight = body.classList.contains('light-theme');
  
  if (isCurrentlyLight) {
    // Switch to dark theme
    body.classList.remove('light-theme');
    body.classList.add('dark-theme');
    if (sunIcon) sunIcon.style.display = 'block';
    if (moonIcon) moonIcon.style.display = 'none';
    localStorage.setItem('theme', 'dark');
  } else {
    // Switch to light theme
    body.classList.remove('dark-theme');
    body.classList.add('light-theme');
    if (sunIcon) sunIcon.style.display = 'none';
    if (moonIcon) moonIcon.style.display = 'block';
    localStorage.setItem('theme', 'light');
  }
};

// Auto-hide navbar on scroll with mobile optimization
let lastScrollY = window.scrollY;
let navbarTimeout: number | undefined;
let isScrolling = false;
let isMobile = window.innerWidth <= 768;

// Update mobile state on resize
window.addEventListener('resize', () => {
  isMobile = window.innerWidth <= 768;
});

function handleScroll() {
  const navbar = document.querySelector('.floating-navbar') as HTMLElement;
  if (!navbar) return;
  
  const currentScrollY = window.scrollY;
  
  // Clear existing timeout
  clearTimeout(navbarTimeout);
  
  // Different behavior for mobile vs desktop
  const hideThreshold = isMobile ? 50 : 100;
  const autoShowDelay = isMobile ? 1500 : 2000;
  
  if (currentScrollY > lastScrollY && currentScrollY > hideThreshold) {
    // Scrolling down - hide navbar (slide up since navbar is at top)
    if (isMobile) {
      navbar.style.transform = 'translateY(-100px)';
    } else {
      navbar.style.transform = 'translateX(-50%) translateY(-100px)';
    }
    navbar.style.opacity = '0.3';
  } else if (currentScrollY < lastScrollY || currentScrollY <= hideThreshold) {
    // Scrolling up or near top - show navbar immediately
    if (isMobile) {
      navbar.style.transform = 'translateY(0)';
    } else {
      navbar.style.transform = 'translateX(-50%) translateY(0)';
    }
    navbar.style.opacity = '1';
  }
  
  lastScrollY = currentScrollY;
  isScrolling = true;
  
  // Auto-show after delay when scrolling stops
  navbarTimeout = setTimeout(() => {
    isScrolling = false;
    if (isMobile) {
      navbar.style.transform = 'translateY(0)';
    } else {
      navbar.style.transform = 'translateX(-50%) translateY(0)';
    }
    navbar.style.opacity = '1';
  }, autoShowDelay);
}

// Smooth scrolling for navigation links
document.addEventListener('DOMContentLoaded', () => {
  // Detect mobile device
  const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
  
  // Initialize theme
  const savedTheme = localStorage.getItem('theme');
  const body = document.body;
  const themeToggle = document.querySelector('.theme-toggle') as HTMLElement;
  
  if (savedTheme === 'light') {
    body.classList.add('light-theme');
    if (themeToggle) {
      const sunIcon = themeToggle.querySelector('.sun-icon') as HTMLElement;
      const moonIcon = themeToggle.querySelector('.moon-icon') as HTMLElement;
      if (sunIcon) sunIcon.style.display = 'none';
      if (moonIcon) moonIcon.style.display = 'block';
    }
  } else {
    body.classList.add('dark-theme');
  }
  
  // Set active navigation item based on scroll position
  const navItems = document.querySelectorAll('.nav-item') as NodeListOf<HTMLElement>;
  const sections = document.querySelectorAll('section[id]');
  
  const observerOptions = {
    threshold: 0.3,
    rootMargin: '-50px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        const activeNavItem = document.querySelector(`[href="#${id}"]`);
        
        // Remove active class from all nav items
        navItems.forEach(item => item.classList.remove('active'));
        
        // Add active class to current nav item
        if (activeNavItem && activeNavItem.classList.contains('nav-item')) {
          activeNavItem.classList.add('active');
        }
      }
    });
  }, observerOptions);

  sections.forEach(section => {
    observer.observe(section);
  });

  // Add scroll listener with passive option for better performance
  window.addEventListener('scroll', handleScroll, { passive: true });

  // Add click/touch handlers for smooth scrolling
  navItems.forEach((item: HTMLElement) => {
    const eventType = isTouchDevice ? 'touchstart' : 'click';
    
    item.addEventListener(eventType, (e) => {
      e.preventDefault();
      
      // Add visual feedback for touch
      if (isTouchDevice) {
        item.style.transform = 'scale(0.95)';
        setTimeout(() => {
          item.style.transform = '';
        }, 150);
      }
      
      const href = item.getAttribute('href');
      if (!href) return;
      
      const targetId = href.substring(1);
      const targetSection = document.getElementById(targetId);
      
      if (targetSection) {
        // Show navbar temporarily when navigating
        const navbar = document.querySelector('.floating-navbar') as HTMLElement;
        if (navbar) {
          if (window.innerWidth <= 768) {
            navbar.style.transform = 'translateY(0)';
          } else {
            navbar.style.transform = 'translateX(-50%) translateY(0)';
          }
          navbar.style.opacity = '1';
        }
        
        targetSection.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    }, { passive: false });
    
    // Add touch-specific events for better mobile interaction
    if (isTouchDevice) {
      item.addEventListener('touchend', (e) => {
        item.style.transform = '';
      });
    }
  });
});

// Subtle hover effect only on navbar container
document.addEventListener('DOMContentLoaded', () => {
  const navbarContainer = document.querySelector('.floating-nav-container') as HTMLElement;
  
  if (navbarContainer) {
    navbarContainer.addEventListener('mouseenter', () => {
      navbarContainer.style.transform = 'translateY(-2px) scale(1.02)';
    });
    
    navbarContainer.addEventListener('mouseleave', () => {
      navbarContainer.style.transform = 'translateY(0) scale(1)';
    });
  }
});
</script>